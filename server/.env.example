# ==============================================================================
# SitePulse PostgreSQL & Server Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (pgAdmin / Local / Remote)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Recommended for pgAdmin / Neon / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitepulse

# Option B: Individual Connection Parameters (Alternative)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sitepulse
DB_SSL=false

# ------------------------------------------------------------------------------
# Authentication Security (JWT Secret)
# ------------------------------------------------------------------------------
JWT_SECRET=sitepulse-commercial-saas-hmac-secret-key-2026

# ------------------------------------------------------------------------------
# CORS Allowed Origins (comma-separated)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Outbound Email Providers (Optional: Resend or SendGrid)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....
# EMAIL_FROM=alerts@yourdomain.com

# ------------------------------------------------------------------------------
# Stripe Payment Gateway
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_sitepulse_commercial_webhook_secret_2026

